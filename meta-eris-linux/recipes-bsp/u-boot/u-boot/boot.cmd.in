# U-boot script for eris-linux update system
#
# (c) 2024-2026 Logilin
#
# We use the following environment variables
# - current_boot: the partition number of the last boot.
# - next_boot_1: the partition number on which we'll try to boot at first attempt.
# - next_boot_2: the partition number on which we'll try to boot at second attempt.
# - next_boot_3: the partition number on which we'll try to boot at third attempt.
# - recovery_part: the recovery partition number (never updated).
# - rollback: 0 normal boot, 1 first boot after update, 2 rollback from failed boot.

# Our partition scheme for A/B/R update mechanism is:
#
# - part #1: BOOT (the bootloader).
# - part #2: RECOVERY (the recovery partition whose content is never modified).
# - part #3: SYSTEM-A (one of the two system partitions).
# - part #4: Extended partition
# - part #5: SYSTEM-B (one of the two system partitions).
# - part #6: DATA (the runtime writable storage partition).

# We use the following meta-variables (filled in u-boot.bb_append)
#
# - @@ERIS_BLOCK_DEVICE@@: block device number (ex: 0 for mmc 0)
# - @@ERIS_BOOT_COMMAND@@: the command to use to boot the loaded kernel.
# - @@ERIS_BOOT_MEDIA@@: the type of block device media (ex: mmc).
# - @@ERIS_CHOSEN_BOOTARGS@@: Initialize bootargs from the Device Tree? [0, 1].
# - @@ERIS_CONSOLE@@: string to add to bootargs to setup console (ex: console=ttyS0,115200).
# - @@ERIS_FDT_ADDR_VAR@@: name of the environment variable containing FDT address (ex: fdt_addr_r).
# - @@ERIS_FDT_IMAGE@@: name of the Flatened Device Tree image file.
# - @@ERIS_GRAPHIC@@: use a graphic display (for splashscreen)? [0, 1].
# - @@ERIS_KERNEL_IMAGE@@: name of the kernel file (ex. zImage).
# - @@ERIS_LOAD_FDT@@: Load a flattened Device Tree image? [0, 1].
# - @@ERIS_RESET_GPIO_IN@@: input GPIO to test for factory reset.
# - @@ERIS_RESET_GPIO_OUT@@: output GPIO to set for factory reset.
# - @@ERIS_UBOOT_LED_GPIO@@: the GPIO of the LED to activate at start of boot.
# - @@ERIS_UBOOT_LED_POWER@@: the start status ([0, 1]) of the boot LED.


if test "@@ERIS_UBOOT_LED_GPIO@@" != ""
then
	if test "@@ERIS_UBOOT_LED_POWER@@" = "1"
	then
		gpio set @@ERIS_UBOOT_LED_GPIO@@
	else
		gpio clear @@ERIS_UBOOT_LED_GPIO@@
	fi
fi

# Set a default configuration
#
if test "${boot_next_1}" = ""
then
	# Default to recovery mmcblk0p2
	setenv  recovery_part 2
	setenv  current_boot  ${recovery_part}
	setenv  boot_next_1   ${recovery_part}
	setenv  boot_next_2   ${recovery_part}
	setenv  boot_next_3   ${recovery_part}
	setenv  rollback      0
	saveenv
else
	if test "${current_boot}" != "${boot_next_1}"
	then
		# We are booting on a partition different of the previous one.
		if test "${rollback}" = "0"
		then
			# Previous boot as failed.
			setenv rollback 2
		fi
		if test "${rollback}" = "1"
		then
			# First boot after update
			setenv rollback 0
		fi
	fi
	setenv current_boot    ${boot_next_1}
	setenv boot_next_1     ${boot_next_2}
	setenv boot_next_2     ${boot_next_3}
	setenv boot_next_3     ${recovery_part}
	saveenv
fi


# Test if reset GPIOs are connected
#
if test "@@ERIS_RESET_GPIO_IN@@" != ""
then
	if test "@@ERIS_RESET_GPIO_OUT@@" != ""
	then
		gpio input @@ERIS_RESET_GPIO_IN@@
		gpio set @@ERIS_RESET_GPIO_OUT@@
		sleep 0.1
		gpio read value @@ERIS_RESET_GPIO_IN@@
		if test ${value} = "1"
		then
			gpio clear @@ERIS_RESET_GPIO_OUT@@
			sleep 0.1
			gpio read value @@ERIS_RESET_GPIO_IN@@
			if test ${value} = "0"
			then
				setenv current_boot ${recovery_part}
			fi
		fi
	fi
fi


# Try to display our splashscreen
#
if test "@@ERIS_GRAPHIC@@" = "1"
then
	cls
	load @@ERIS_BOOT_MEDIA@@ @@ERIS_BLOCK_DEVICE@@:${boot_next_1} ${loadaddr} /boot/splashscreen.bmp
	bmp display ${loadaddr}
fi


# Load the kernel
#
load @@ERIS_BOOT_MEDIA@@ @@ERIS_BLOCK_DEVICE@@:${current_boot} ${kernel_addr_r} /boot/@@ERIS_KERNEL_IMAGE@@


# Load the device tree
#
if test "@@ERIS_LOAD_FDT@@" = "1"
then
	load @@ERIS_BOOT_MEDIA@@ @@ERIS_BLOCK_DEVICE@@:${current_boot} ${@@ERIS_FDT_ADDR_VAR@@} /boot/@@ERIS_FDT_IMAGE@@
fi
fdt addr ${@@ERIS_FDT_ADDR_VAR@@}

# Set bootargs
#
if test "@@ERIS_CHOSEN_BOOTARGS@@" = "1"
then
	fdt get value bootargs /chosen bootargs
else
	setenv bootargs ""
fi
setenv bootargs "${bootargs} root=/dev/mmcblk@@ERIS_BLOCK_DEVICE@@p${current_boot} quiet rootwait ro init=/sbin/early-init @@ERIS_CONSOLE@@"

# Go!
#
@@ERIS_BOOT_COMMAND@@ ${kernel_addr_r} - ${@@ERIS_FDT_ADDR_VAR@@}
	
