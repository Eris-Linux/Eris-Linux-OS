# U-boot script for eris-linux update system
#
# (c) 2024-2026 Logilin
#

# We use and modify the following environment variables:
# - confirmed_partition: definitely confirmed partition number (after a whole successful boot).
# - candidate_partition: the partition number on which we'll try to boot.
# - boot_state: current status of the finite-state-machine.
# - boot_attempts: the remaining attempts for current stage.
# - recovery_done: "1" when a successful recovering for initramfs has occurred, "0" otherwise.
#
# The boot states (constants replaced by their values in uboot.bb):
#  @@ERIS_BOOT_STATUS_STABLE@@: a partition is confirmed.
#    This is written by a Linux script at the end of a full boot in `TRIAL`mode.
#    The script will boot on `confirmed_partition`.
#  @@ERIS_BOOT_STATUS_TRIAL@@: the system will try a new update.
#  @@ERIS_BOOT_STATUS_ROLLBACK@@: the system will return back to the confirmed partition.
#  @@ERIS_BOOT_STATUS_REPAIR@@: check and repair of Data partition, then retry confirmed partition.
#  @@ERIS_BOOT_STATUS_RESET@@: restore the data previously saved
#  @@ERIS_BOOT_STATUS_RESCUE@@: a manuel action is needed.
#

# We use the following local variables not saved in environment:
# - _boot_on: partition number (as a string), "0" while the boot isn't possible.
# - _initramfs: "1" if we need to boot on the recovery ramfs, "0" otherwise.
# - _initramfs_size: size of the recovery rootfs loaded in RAM (zero for partition-based boot).

# Our partition scheme for A/B/R update mechanism is:
#
# - part #1: BOOT (the bootloader and recovery stuff: kernel, device tree and initramfs).
# - part #2: SYSTEM-A (one of the two system partitions).
# - part #3: SYSTEM-B (one of the two system partitions).
# - part #4: DATA (the runtime writable storage partition).

# We use the following meta-variables (filled in u-boot.bb_append)
#
# - @@ERIS_BOOT_MEDIA@@: the type of block device media (ex: mmc).
# - @@ERIS_BLOCK_DEVICE@@: block device number (ex: 0 for mmc 0)
# - @@ERIS_BOOT_PART@@: Boot partition number (ex. 1).
# - @@ERIS_SYSTEM_A_PART@@: System-A partition number (ex. 2).
# - @@ERIS_SYSTEM_B_PART@@: System-B partition number (ex. 3).
# - @@ERIS_DATA_PART@@: Data partition number (ex. 4).

# - @@ERIS_KERNEL_IMAGE@@: name of the kernel file (ex. zImage).

# - @@ERIS_FDT_MODE@@: "load" (load an image), "firmware" (already loaded by firmware), "none" (no fdt).
# - @@ERIS_FDT_ADDR_VAR@@: name of the environment variable containing FDT address (ex: fdt_addr_r).
# - @@ERIS_FDT_IMAGE@@: name of the Flatened Device Tree image file.

# - @@ERIS_CHOSEN_BOOTARGS@@: Initialize bootargs from the Device Tree? [0, 1].
# - @@ERIS_CONSOLE@@: string to add to bootargs to setup console (ex: console=ttyS0,115200).

# - @@ERIS_BOOT_COMMAND@@: the command to use to boot the loaded kernel.
# - @@ERIS_DEBUG_DISPLAY@@: display our variables before booting? [0, 1].

# - @@ERIS_RECOVERY_RAMFS@@: the name of the recovery initramfs.

# - @@ERIS_GRAPHIC@@: use a graphic display (for splashscreen)? [0, 1].

# - @@ERIS_RESET_GPIO_IN@@: input GPIO to test for factory reset (leave empty to ignore).
# - @@ERIS_RESET_GPIO_OUT@@: output GPIO to set for factory reset.
# - @@ERIS_UBOOT_LED_GPIO@@: the GPIO of the LED to activate at start of boot (leave empty to ignore).
# - @@ERIS_UBOOT_LED_POWER@@: the start status ([0, 1]) of the boot LED.


# Defaut value for local variables.
#
_boot_on="0"
_initramfs="0"
_initramfs_size=0


# Set a default configuration for environment variables at first boot.
#
if test "${boot_state}" != "@@ERIS_BOOT_STATUS_STABLE@@"; then
if test "${boot_state}" != "@@ERIS_BOOT_STATUS_TRIAL@@"; then
if test "${boot_state}" != "@@ERIS_BOOT_STATUS_ROLLBACK@@"; then
if test "${boot_state}" != "@@ERIS_BOOT_STATUS_REPAIR@@"; then
if test "${boot_state}" != "@@ERIS_BOOT_STATUS_RESET@@"; then
if test "${boot_state}" != "@@ERIS_BOOT_STATUS_RESCUE@@"; then
	setenv boot_state "@@ERIS_BOOT_STATUS_STABLE@@"
	setenv confirmed_partition "@@ERIS_SYSTEM_A_PART@@"
	setenv candidate_partition ""
	setenv boot_attempts @@ERIS_MAX_BOOT_ATTEMPTS@@
	setenv recovery_done "0"
fi; fi; fi; fi; fi; fi


# Turn the boot LED on.
#
if test "@@ERIS_UBOOT_LED_GPIO@@" != ""
then
	if test "@@ERIS_UBOOT_LED_POWER@@" = "1"
	then
		gpio set @@ERIS_UBOOT_LED_GPIO@@
	else
		gpio clear @@ERIS_UBOOT_LED_GPIO@@
	fi
fi


# If reset GPIOs are connected, switch to Reset state.
#
if test "@@ERIS_RESET_GPIO_IN@@" != ""
then
	if test "@@ERIS_RESET_GPIO_OUT@@" != ""
	then
		gpio input @@ERIS_RESET_GPIO_IN@@
		gpio set @@ERIS_RESET_GPIO_OUT@@
		sleep 0.1
		gpio read _value @@ERIS_RESET_GPIO_IN@@
		if test "${_value}" = "1"
		then
			gpio clear @@ERIS_RESET_GPIO_OUT@@
			sleep 0.1
			gpio read _value @@ERIS_RESET_GPIO_IN@@
			if test "${_value}" = "0"
			then
				setenv boot_state    "@@ERIS_BOOT_STATUS_RESET@@"
				setenv boot_attempts  @@ERIS_MAX_BOOT_ATTEMPTS@@
				setenv recovery_done  "0"
				saveenv
			fi
		fi
		gpio clear @@ERIS_RESET_GPIO_OUT@@
	fi
fi


# Stable (normal) state: boot on confirmed partition.
# In case of repeated failures, switch to repair state.
#
if test "${boot_state}" = "@@ERIS_BOOT_STATUS_STABLE@@"
then
	if test "${boot_attempts}" -gt 0
	then
		setexpr boot_attempts ${boot_attempts} - 1
		saveenv
		_boot_on="${confirmed_partition}"
	else
		setenv boot_state    "@@ERIS_BOOT_STATUS_REPAIR@@"
		setenv boot_attempts  @@ERIS_MAX_BOOT_ATTEMPTS@@
		setenv recovery_done  "0"
		saveenv
	fi
fi


# Trial state: boot on candidate partition.
# In case of repeated failures, switch to Rollback state.
#
if test "${_boot_on}" = "0"
then
	if test "${boot_state}" = "@@ERIS_BOOT_STATUS_TRIAL@@"
	then
		if test "${boot_attempts}" -gt 0
		then
			setexpr boot_attempts ${boot_attempts} - 1
			saveenv
			_boot_on="${candidate_partition}"
		else
			#save_failure_event(${candidate_partition})
			setenv boot_state    "@@ERIS_BOOT_STATUS_ROLLBACK@@"
			setenv boot_attempts  @@ERIS_MAX_BOOT_ATTEMPTS@@
			setenv recovery_done  "0"
			saveenv
		fi
	fi
fi


# Rollback state: restore saved data, and boot on confirmed partition
# In case of repeated failures, switch to Repair state.
#
if test "${_boot_on}" = "0"
then
	if test "${boot_state}" = "@@ERIS_BOOT_STATUS_ROLLBACK@@"
	then
		if test "${recovery_done}" != "1"
		then
			_initramfs="1"
		else
			if test "${boot_attempts}" -gt 0
			then
				setexpr boot_attempts ${boot_attempts} - 1
				saveenv
				_boot_on="${confirmed_partition}"
			else
				setenv boot_state    "@@ERIS_BOOT_STATUS_REPAIR@@"
				setenv boot_attempts  @@ERIS_MAX_BOOT_ATTEMPTS@@
				setenv recovery_done  "0"
				saveenv
			fi
		fi
	fi
fi


# Repair state: restore all data partition and go back to confirmed partition
# In case of repeated failures, switch to Reset state.
# 
if test "${_boot_on}" = "0"
then
	if test "${boot_state}" = "@@ERIS_BOOT_STATUS_REPAIR@@"
	then
		if test "${recovery_done}" != "1"
		then
			_initramfs="1"
		else
			if test "${boot_attempts}" -gt 0
			then
				setexpr boot_attempts ${boot_attempts} - 1
				saveenv
				_boot_on="${confirmed_partition}"
			else
				setenv boot_state    "@@ERIS_BOOT_STATUS_RESET@@"
				setenv boot_attempts  @@ERIS_MAX_BOOT_ATTEMPTS@@
				setenv recovery_done  "0"
				saveenv
			fi
		fi
	fi
fi


# Reset state: erase all data partition and go back to confirmed partition.
#
if test "${_boot_on}" = "0"
then
	if test "${boot_state}" = "@@ERIS_BOOT_STATUS_RESET@@"
	then
		if test "${recovery_done}" != "1"
		then
			_initramfs="1"
		else
			if test "${boot_attempts}" -gt 0
			then
				setexpr boot_attempts ${boot_attempts} - 1
				saveenv
				_boot_on="${confirmed_partition}"
			else
				setenv boot_state   "@@ERIS_BOOT_STATUS_RESCUE@@"
				saveenv
			fi
		fi
	fi
fi


# Rescue state: a manual intervention is needed.
#
if test "${_boot_on}" = "0"
then
	if test "${boot_state}" = "@@ERIS_BOOT_STATUS_RESCUE@@"
	then
		echo "Eris Linux: fatal boot error."
		echo "System halted in U-Boot."
		while test 1 -eq 1
		do
			sleep 1
		done
	fi
fi


# Try to display our splashscreen
#
if test "${_initramfs}" = "0" -a "${_boot_on}" != "0"
then
	if test "${boot_state}" = "@@ERIS_BOOT_STATUS_STABLE@@" -o "${boot_state}" = "@@ERIS_BOOT_STATUS_TRIAL@@" -o "${boot_state}" = "@@ERIS_BOOT_STATUS_ROLLBACK@@"
	then
		if test "@@ERIS_GRAPHIC@@" = "1"
		then
			cls
			if load @@ERIS_BOOT_MEDIA@@ @@ERIS_BLOCK_DEVICE@@:${_boot_on} ${loadaddr} /boot/splashscreen.bmp
			then
				bmp display ${loadaddr}
			fi
		fi
	fi
fi


# Load the kernel
#
if test "${_boot_on}" != "0"
then
	if load @@ERIS_BOOT_MEDIA@@ @@ERIS_BLOCK_DEVICE@@:${_boot_on} ${kernel_addr_r} /boot/@@ERIS_KERNEL_IMAGE@@
	then
		echo "Kernel loaded"
	else
		echo "Unable to load kernel from partition ${candidate_partition}."
		_boot_on=0
	fi
else
	if test "${_initramfs}" = "1"
	then
		if load @@ERIS_BOOT_MEDIA@@ @@ERIS_BLOCK_DEVICE@@:@@ERIS_BOOT_PART@@ ${kernel_addr_r} /@@ERIS_KERNEL_IMAGE@@
		then
			echo "Recovery kernel loaded."
		else
			echo "Unable to load recovery kernel."
			_initramfs="0"
		fi
	fi
fi


# Load the device tree
#
if test "@@ERIS_FDT_MODE@@" = "load"
then
	if test "${_initramfs}" != "0"
	then
		if load @@ERIS_BOOT_MEDIA@@ @@ERIS_BLOCK_DEVICE@@:@@ERIS_BOOT_PART@@ ${@@ERIS_FDT_ADDR_VAR@@} /@@ERIS_FDT_IMAGE@@
		then
			if fdt addr ${@@ERIS_FDT_ADDR_VAR@@}
			then
				echo "Recovery device tree loaded."
			else
				echo "Unable to select recovery device tree at ${@@ERIS_FDT_ADDR_VAR@@}."
				_initramfs="0"
			fi
		else
			echo "Unable to load recovery device tree."
			_initramfs="0"
		fi
	else
		if test "${_boot_on}" != 0
		then
			if load @@ERIS_BOOT_MEDIA@@ @@ERIS_BLOCK_DEVICE@@:${_boot_on} ${@@ERIS_FDT_ADDR_VAR@@} /boot/@@ERIS_FDT_IMAGE@@
			then
				if fdt addr ${@@ERIS_FDT_ADDR_VAR@@}
				then
					echo "Device tree loaded."
				else
					echo "Unable to select device tree at ${@@ERIS_FDT_ADDR_VAR@@}."
					_boot_on="0"
				fi
			else
				echo "Unable to load device tree from partition ${_boot_on}."
				_boot_on="0"
			fi
		fi
	fi
else
	if test "@@ERIS_FDT_MODE@@" = "firmware"
	then
		if fdt addr ${@@ERIS_FDT_ADDR_VAR@@}
		then
			echo "Firmware device tree present."
		else
			echo "Unable to load firmware device tree at ${@@ERIS_FDT_ADDR_VAR@@}."
			_boot_on="0"
			_initramfs="0"
		fi
	fi
fi


# Load the ramfs.
#
if test "${_initramfs}" = "1"
then

	if load @@ERIS_BOOT_MEDIA@@ @@ERIS_BLOCK_DEVICE@@:@@ERIS_BOOT_PART@@ ${ramdisk_addr_r} /@@ERIS_RECOVERY_RAMFS@@
	then
		_initramfs_size="${filesize}"
	else
		echo "Unable to load recovery initramfs."
		_initramfs=0
	fi
fi


# Set bootargs
#
if test "${_boot_on}" != "0" -o "${_initramfs}" = "1"
then
	setenv bootargs ""
	if test "@@ERIS_CHOSEN_BOOTARGS@@" = "1"
	then
		if test "@@ERIS_FDT_MODE@@" != "none"
		then
			if fdt get value bootargs /chosen bootargs
			then
				echo "Bootargs initialized."
			else
				setenv bootargs ""
			fi
		fi
	fi
	
	if test "${_boot_on}" != "0"
	then
		if part uuid @@ERIS_BOOT_MEDIA@@ @@ERIS_BLOCK_DEVICE@@:${_boot_on} root_partuuid
		then
			setenv bootargs "${bootargs} root=PARTUUID=${root_partuuid} quiet rootwait ro init=/sbin/early-init @@ERIS_CONSOLE@@"
			_boot_on_ramfs="-"
		else
			echo "Unable to get UUID for partition ${_boot_on}."
			_boot_on="0"
		fi
	else
		setenv bootargs "${bootargs} rdinit=/init quiet rootwait @@ERIS_CONSOLE@@"
		_boot_on_ramfs="${ramdisk_addr_r}:${_initramfs_size}"
	fi
fi

if test "@@ERIS_DEBUG_DISPLAY@@" = "1"
then
	echo "Boot State=${boot_state}"
	echo "Boot on=${_boot_on}"
	echo "Boot_attempts=${boot_attempts}"
	echo "fdt_mode=@@ERIS_FDT_MODE@@"
	echo "fdt_addr=${@@ERIS_FDT_ADDR_VAR@@}"
	echo "bootargs=${bootargs}"
fi

# Go!
#
if test "${_boot_on}" != "0" -o "${_initramfs}" != "0"
then
	if test "@@ERIS_FDT_MODE@@" != "none"
	then
		@@ERIS_BOOT_COMMAND@@ ${kernel_addr_r} ${_boot_on_ramfs} ${@@ERIS_FDT_ADDR_VAR@@}
	else
		@@ERIS_BOOT_COMMAND@@ ${kernel_addr_r} ${_boot_on_ramfs}
	fi
fi


# If we reach this point, try a reset to reach Repair or Reset.
#
reset

